#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx and a custom X-Served-By HTTP header

sudo apt-get update -y
sudo apt-get install -y nginx

# Add X-Served-By header with server hostname to Nginx config if not present
if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    sudo sed -i "/server_name _;/a \    add_header X-Served-By \$hostname;" /etc/nginx/sites-available/default
fi

# Fallback: ensure header is present in main config if default block edit didn't catch
if ! grep -q "X-Served-By" /etc/nginx/nginx.conf; then
    sudo sed -i "/http {/a \    add_header X-Served-By \$hostname;" /etc/nginx/nginx.conf
fi

sudo service nginx restart
